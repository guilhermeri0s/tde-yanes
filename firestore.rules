rules_version = '2';

// Modelo de papéis:
//  - gerente:     cadastra/edita/remove prateleiras, vê tudo
//  - repositor:   vê prateleiras, alertas e histórico; registra reposições
//  - dispositivo: conta usada pela balança/hardware; só pode atualizar
//                 o peso (currentWeightKg) e o timestamp de uma prateleira
//
// O papel de cada usuário fica em users/{uid}.role e é criado manualmente
// no console do Firebase (ver README.md).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isGerente() {
      return isSignedIn() && userRole() == 'gerente';
    }

    function isRepositor() {
      return isSignedIn() && userRole() == 'repositor';
    }

    function isDispositivo() {
      return isSignedIn() && userRole() == 'dispositivo';
    }

    // Perfil do próprio usuário — leitura só do próprio doc.
    // Escrita é feita manualmente pelo console (ou por um admin SDK externo).
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Prateleiras: qualquer usuário autenticado lê.
    // Gerente cria/edita/remove livremente.
    // Dispositivo (balança) só pode alterar currentWeightKg e updatedAt
    // de uma prateleira que já existe — nunca cria, remove, nem muda
    // nome, capacidade, peso unitário etc.
    match /shelves/{shelfId} {
      allow read: if isSignedIn();
      allow create, delete: if isGerente();
      allow update: if isGerente()
        || (
          isDispositivo() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['currentWeightKg', 'updatedAt'])
        );
    }

    // Histórico: qualquer usuário autenticado lê e registra eventos
    // (o painel grava as transições de status automaticamente).
    // Não é editável nem removível — é um log.
    match /history/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
